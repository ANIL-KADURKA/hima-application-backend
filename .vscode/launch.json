{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: runserver (LAN)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/manage.py",
            "args": ["runserver", "0.0.0.0:8000"],
            "django": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1,192.168.1.20"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
